* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf

# Keep source and configuration files consistent across Windows and CI.
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.sh text eol=lf

# Windows scripts.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ttf binary
*.otf binary
*.jks binary
*.keystore binary
